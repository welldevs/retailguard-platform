# Credentials — NEVER commit
.env
.env.*

# dbt profiles with real credentials
profiles.yml
!profiles.yml.example

# Private keys (DBT_USER key-pair auth) — NEVER commit. Public keys are not secret.
*.p8
*.pem
keys/
# NOTE: scripts/gen_dbt_keypair.sh is INTENTIONALLY tracked (it generates keys, contains no secrets).

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage

# dbt artifacts (generated, not versioned)
dbt/target/
dbt/dbt_packages/
dbt/logs/

# Streamlit deploy bundle (generated by `snow streamlit deploy`)
snowflake/output/

# Personal study material — kept LOCAL only, never committed
docs/faq.md
# Portuguese/informal KPI glossary — kept local; public repo documents KPIs via dbt _kpi.yml
docs/kpi.md
# Internal pre-publication remediation runbook (references old private-repo history) — kept local
docs/security_remediation.md

# DuckDB files (generated, path controlled via env var)
*.duckdb
*.duckdb.wal

# Source layer exports (regenerated by simulator — NOT versioned)
source/
# seed_sample/

# Mercadona resource data (large scraped files, regenerate with scraper.py)
erp/resources/mercadona/*.csv
!erp/resources/mercadona/stores_mercadona.csv
erp/resources/mercadona/*.json

# Logs
logs/
*.log

# IDE
.vscode/
.idea/
*.swp

# Claude Code local settings (tool permissions — machine-specific)
.claude/

# Terraform — secrets and generated state
# NOTE: git does NOT support inline (end-of-line) comments in .gitignore —
# each comment MUST be on its own line, or the pattern silently fails to match.
# terraform.tfvars contains secrets — use terraform.tfvars.example as the template
terraform/terraform.tfvars
# provider cache — regenerated by terraform init
terraform/.terraform/
# state + ALL backups (incl. numbered *.tfstate.<timestamp>.backup) — contains credentials
terraform/*.tfstate*
terraform/crash.log
# terraform/.terraform.lock.hcl is intentionally COMMITTED (pins provider versions)

# OS
.DS_Store
Thumbs.db
